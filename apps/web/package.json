    "check:flows": "tsx tests/unit/store-flows.test.ts",
    "check:overlays": "tsx tests/unit/overlays.test.tsx",
    "check:logger": "tsx tests/unit/logger.test.ts",
    "check:payments": "tsx tests/unit/payments.test.ts",
    "check:scoping": "tsx tests/integration/scoping.test.ts",
    "check:auth-guards": "tsx tests/integration/auth-guards.test.ts",
