model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String    @default("")
  ctaLabel  String    @default("")
  ctaHref   String    @default("")
  accent    String    @default("orange")
  active    Boolean   @default(false)
  startsOn  DateTime?
  endsOn    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MediaAsset {
  id        String    @id @default(cuid())
  label     String
  kind      MediaKind @default(image)
  category  String    @default("")
  sizeKb    Int       @default(0)
  emoji     String    @default("🖼️")
  url       String    @default("")
  usedOn    String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
}

model Testimonial {
  id         String   @id @default(cuid())
  parentName String
  childName  String   @default("")
  relation   String   @default("")
  rating     Int      @default(5)
  quote      String
  emoji      String   @default("💬")
  videoUrl   String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model AppNotification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(SYSTEM)
  title     String
  body      String           @default("")
  href      String?
  read      Boolean          @default(false)
  emoji     String           @default("🔔")
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Record<NotificationChannel, boolean>
  channels   Json     @default("{}")
  mutedKinds String[]
  // { from: "HH:mm", to: "HH:mm" } | null
  quietHours Json?
  updatedAt  DateTime @updatedAt
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The Expo/FCM push token. Unique so re-registering a device replaces it.
  token      String?        @unique
  platform   DevicePlatform @default(WEB)
  label      String         @default("")
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Safety
// ---------------------------------------------------------------------------

model EmergencyContact {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  relation  String   @default("")
  phone     String
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, priority])
}

model MedicalProfile {
  studentId   String   @id
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodGroup  String   @default("")
  allergies   String[]
  conditions  String[]
  medications String[]
  doctorName  String   @default("")
  doctorPhone String   @default("")
  insuranceNo String   @default("")
  notes       String   @default("")
  updatedAt   DateTime @updatedAt
}

model SafetyBroadcast {
  id         String            @id @default(cuid())
  title      String
  body       String
  severity   BroadcastSeverity @default(INFO)
  branchId   String?
  branch     Branch?           @relation(fields: [branchId], references: [id])
  sentByName String
  createdAt  DateTime          @default(now())

  acks BroadcastAck[]

  @@index([createdAt])
}

model BroadcastAck {
  broadcastId String
  broadcast   SafetyBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ackedAt     DateTime        @default(now())

  @@id([broadcastId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Admin ops
// ---------------------------------------------------------------------------

model AuditEntry {
  id        String   @id @default(cuid())
  actorName String
  actorRole Role
  action    String
  target    String   @default("")
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Editable permission set per role (/admin/roles). The four rows are seeded and
// `system` ones cannot be deleted.
model RoleDefinition {
  role        Role     @id
  label       String
  description String   @default("")
  permissions String[]
  system      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Single row (id = "singleton"): school-wide settings and feature flags.
model SchoolSettings {
  id            String   @id @default("singleton")
  schoolName    String
  tagline       String   @default("")
  supportEmail  String   @default("")
  supportPhone  String   @default("")
  whatsapp      String   @default("")
  address       String   @default("")
  academicYear  String   @default("")
  currency      String   @default("INR")
  timezone      String   @default("Asia/Kolkata")
  locale        String   @default("en")
  // { cctv, kidsZone, onlinePayments, messaging, admissionsOnline, seasonalTheme }
  features      Json     @default("{}")
  seasonalTheme String   @default("none")
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CCTV — control plane. The media plane (MediaMTX) never touches this DB;
// it only calls /api/cctv/authorize. See docs/erp-cctv.md.
// ---------------------------------------------------------------------------

model Camera {
  id          String     @id @default(cuid())
  name        String
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id])
  // Camera physically covers this classroom; parents of students in this
  // classroom get access (subject to the checks below).
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  // MediaMTX path this feed is published at (e.g. "classroom-a"). The browser
  // opens WHEP against MEDIAMTX_WHEP_URL/<streamPath>/whep.
  streamPath String @unique
  // Source RTSP URL (may embed credentials). SERVER-SIDE ONLY — never sent to a
  // browser. MediaMTX pulls from here; parents only ever get a view token.
  rtspUrl    String

  // Global on/off (admin kill-switch). When false nobody can view.
  enabled        Boolean @default(true)
  // Whether parents (vs. staff only) may view this camera at all.
  parentViewable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessGrants CameraAccessGrant[]
  cctvLogs     CctvViewLog[]

  @@index([branchId])
  @@index([classroomId])
}

// Explicit per-user grant, on top of (or instead of) classroom-derived access.
// `allow=false` acts as an explicit revocation for a specific parent.
model CameraAccessGrant {
  id        String   @id @default(cuid())
  cameraId  String
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allow     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([cameraId, userId])
  @@index([userId])
}

// Weekly school-hours window per branch. Live viewing is only permitted inside
// one of these windows (evaluated in the branch timezone). dayOfWeek: 0=Sun..6=Sat.
model SchoolHours {
  id        String @id @default(cuid())
  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id])
  dayOfWeek Int
  // Minutes from midnight, local branch time (e.g. 8*60 = 480 for 08:00).
  openMin   Int
  closeMin  Int

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

// Immutable audit trail: every authorize decision + view start is logged.
model CctvViewLog {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  cameraId  String
  camera    Camera        @relation(fields: [cameraId], references: [id])
  action    CctvLogAction
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([cameraId])
  @@index([createdAt])
}
