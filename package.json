{
  "name": "climbkiddo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@climbkiddo/web",
    "build": "npm run build --workspace=@climbkiddo/web",
    "start": "npm run start --workspace=@climbkiddo/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile": "npm run start --workspace=@climbkiddo/mobile",
    "db:push": "npm run db:push --workspace=@climbkiddo/web",
    "db:migrate": "npm run db:migrate --workspace=@climbkiddo/web",
    "db:seed": "npm run db:seed --workspace=@climbkiddo/web",
    "db:studio": "npm run db:studio --workspace=@climbkiddo/web",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
