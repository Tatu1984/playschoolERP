    "check:bootstrap": "tsx tests/integration/bootstrap.test.ts",
    "check:cctv": "tsx tests/integration/cctv.test.ts",
    "check:fees-attendance": "tsx tests/integration/fees-attendance.test.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run check:flows && npm run check:overlays && npm run check:payments && npm run check:logger",
